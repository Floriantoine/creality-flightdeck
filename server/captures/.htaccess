# Seulement des images ici : aucun script ne peut s'exécuter, pas de liste des fichiers
Options -Indexes
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
